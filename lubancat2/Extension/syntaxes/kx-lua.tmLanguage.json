{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kine-X Lua",
  "scopeName": "source.kx-lua",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#command"
    },
    {
      "include": "#builtin"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.kx-lua",
          "begin": "--\\[=*\\[",
          "end": "\\]=*\\]"
        },
        {
          "name": "comment.line.double-dash.kx-lua",
          "begin": "--",
          "end": "$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.kx-lua",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.kx-lua",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.kx-lua",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.kx-lua",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.other.multiline.kx-lua",
          "begin": "\\[=*\\[",
          "end": "\\]=*\\]"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.kx-lua",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.kx-lua",
          "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "name": "keyword.control.kx-lua",
      "match": "\\b(and|break|do|else|elseif|end|false|for|function|goto|if|in|local|nil|not|or|repeat|return|then|true|until|while)\\b"
    },
    "command": {
      "name": "support.function.kx-lua",
      "match": "\\b(DRIVE_CONTROLWORD|NODE_AXIS_COUNT|DISABLE_GROUP|DRIVE_PROFILE|AXIS_ADDRESS|PORT_CLIENTS|MODBUS_IEEE|MOTION_MODE|NODE_STATUS|PORT_STATUS|PORT_TARGET|PROC_STATUS|AXISSTATUS|MBD_STATUS|MBREG_ZONE|MODBUS_REG|NODE_COUNT|REGMAP_GET|SCAN_EVENT|SLOT_START|MBREG_PUT|NODE_INFO|PORT_INFO|RAPIDSTOP|SDO_WRITE|SLOT_SCAN|SLOT_STOP|ETH_MODE|ETHERCAT|MB_WRITE|MBD_LIST|MOVE_ABS|NODE_AIO|PORT_MAX|STOPTASK|VP_SPEED|WAITIDLE|BUSSTOP|DISABLE|ECUSTOM|ENABLED|FASTDEC|JOGLEAD|MB_LIST|MB_READ|MOVEABS|MOVEREL|NODE_IO|PUTCHAR|RUNTASK|CANCEL|ENABLE|ISIDLE|ACCEL|ALARM|ATYPE|BUSOK|CLOSE|DATUM|DECEL|DELAY|NVGET|NVSET|PRINT|SLEEP|SPEED|SRAMP|TICKS|UNITS|VMOVE|AXIS|BASE|BUSY|DPOS|HOME|IDLE|MOVE|MOVR|MPOS|OPEN|SCAN|STOP|VJOG|WAIT|BUS|DIS|GET|JOG|POS|EN)\\b"
    },
    "builtin": {
      "name": "support.function.builtin.kx-lua",
      "match": "\\b(print|type|tostring|tonumber|pairs|ipairs|next|select|math|string|table|os|io)\\b"
    },
    "constants": {
      "name": "constant.language.kx-lua",
      "match": "\\b(_G|_ENV|_VERSION|MV_[A-Z0-9_]+)\\b"
    },
    "operators": {
      "name": "keyword.operator.kx-lua",
      "match": "(==|~=|<=|>=|\\.\\.|\\bnot\\b|\\band\\b|\\bor\\b|[+\\-*/%^#<>=])"
    }
  }
}
